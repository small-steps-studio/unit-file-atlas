# feed-importer.service (invented example)
[Unit]
Description=feed importer service
Wants=network-online.target

[Service]
Type=oneshot
User=svc-feed
WorkingDirectory=/srv/feed-importer
ExecStartPre=/usr/bin/test -f /etc/feed-importer/config.toml
ExecStart=/usr/bin/feed-importer --port 8017
ExecStart=/usr/bin/feed-importer-cleanup
Restart=on-abnormal
RestartSec=10x
TimeoutStartSec=30s
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallFilter=@system-service
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
